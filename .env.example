# Orbitex Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL
NEXT_PUBLIC_API_URL=https://orbitex-backend-976099405307.us-central1.run.app

# Auth Service URL
NEXT_PUBLIC_AUTH_SERVICE_URL=https://orbitex-auth-service-976099405307.us-central1.run.app

# =============================================================================
# Frontend URLs
# =============================================================================

# Main Frontend URL
NEXT_PUBLIC_FRONTEND_URL=https://orbitex-frontend.vercel.app

# Admin Dashboard URL
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=https://orbitex-admin-dashboard.vercel.app

# =============================================================================
# WebSocket Configuration
# =============================================================================

# WebSocket URL for real-time data
NEXT_PUBLIC_WS_URL=wss://socketeer-976099405307.us-central1.run.app/public

# =============================================================================
# Feature Flags
# =============================================================================

# Enable Two-Factor Authentication
NEXT_PUBLIC_ENABLE_2FA=true

# Enable KYC (Know Your Customer)
NEXT_PUBLIC_ENABLE_KYC=true

# Enable WebAuthn (Web Authentication)
NEXT_PUBLIC_ENABLE_WEBAUTHN=false

# =============================================================================
# Analytics & Monitoring
# =============================================================================

# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# External Services
# =============================================================================

# KYC Service URL
NEXT_PUBLIC_KYC_AID_URL=

# =============================================================================
# Development & Build Configuration
# =============================================================================

# Skip environment validation (for development)
SKIP_ENV_VALIDATION=false

# Google Site Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# =============================================================================
# Server-side Environment Variables (not exposed to client)
# =============================================================================

# Database URLs (server-side only)
DATABASE_URL=
DATABASE_URL_AUTH=

# Redis URL (server-side only)
REDIS_URL=

# JWT Secrets (server-side only)
JWT_SECRET=
JWT_REFRESH_SECRET=

# SMTP Configuration (server-side only)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# External Services (server-side only)
KYC_AID_URL=
SENTRY_DSN=

# =============================================================================
# Notes
# =============================================================================

# 1. Variables prefixed with NEXT_PUBLIC_ are exposed to the client
# 2. Variables without NEXT_PUBLIC_ are server-side only
# 3. Never commit .env.local to version control
# 4. Use strong, unique secrets for JWT_SECRET and JWT_REFRESH_SECRET
# 5. Database URLs should include credentials and be kept secure
